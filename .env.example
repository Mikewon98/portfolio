# Copy to .env and fill in real values. Never commit .env.

# --- Payload CMS ---
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Local dev (docker-compose.dev.yml). In production docker-compose.yml builds this from POSTGRES_PASSWORD.
DATABASE_URI=postgres://payload:payload@127.0.0.1:5432/payload
# Production database password (used by the postgres service in docker-compose.yml)
POSTGRES_PASSWORD=change-me

# Optional: lets `npm run seed` create the first admin user
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# --- Contact form ---
RESEND_API_KEY=

# --- Watchtower notifications ---
DISCORD_WEBHOOK_URL=
